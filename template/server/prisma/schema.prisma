generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  avatarUrl     String?   // SEO-friendly path: /uploads/users/{userId}/avatar/{firstName-lastName}-avatar.webp
  role          UserRole  @default(USER)
  // Admin ban switch ONLY: false = deactivated by an admin (or soft-deleted).
  // Never use it to mean "email not verified" — that is emailVerifiedAt. Mixing
  // the two let a banned user re-activate themselves through the verify link.
  isActive      Boolean   @default(true)
  // Set when the user proves ownership of their email (or an admin approves
  // them). Null = not verified; login requires it only while
  // REQUIRE_USER_VERIFICATION is on.
  emailVerifiedAt DateTime?
  deletedAt     DateTime?

  // Account lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens RefreshToken[]
  sessions      Session[]
  blockedIps    BlockedIp[]

  // Performance indexes for high-traffic scenarios (10K-100K users/day)
  @@index([role])           // For role-based authorization queries
  @@index([isActive])       // For filtering active/inactive users
  @@index([deletedAt])      // For soft delete filtering
  @@index([email, isActive]) // Compound index for login queries
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  sessionId String?  // Links token to its session for direct lookup on logout
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // A refresh token lives only as long as its session: deleting the session
  // (logout, admin force-expire, the expiry cleanup job) deletes its tokens, so
  // a login can never outlive the session record users and admins see.
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Performance indexes for token operations and cleanup
  @@index([userId])
  @@index([token])
  @@index([userId, expiresAt]) // Compound index for efficient token cleanup queries
  @@index([expiresAt])         // For expired token cleanup cron jobs
  @@index([sessionId])         // For deleting tokens by session (admin force-expire)
  @@map("refresh_tokens")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  deviceInfo   String?   @db.VarChar(500) // User agent, device type
  ipAddress    String?   @db.VarChar(45)  // IPv4 or IPv6
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  // Performance indexes for session queries
  @@index([userId])
  @@index([userId, expiresAt])
  @@index([expiresAt])         // For expired session cleanup
  @@map("sessions")
}

model BlockedIp {
  id        String   @id @default(uuid())
  ip        String   @unique @db.VarChar(45)
  reason    String?  @db.VarChar(500)
  // Admin who created the block. Nullable + SetNull: deleting that admin (the
  // 30-day account purge) must neither fail nor remove the block — the block
  // stays in force, only "who blocked it" is lost. With a required relation the
  // database refused the delete and the purge got stuck on that admin forever.
  blockedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [blockedBy], references: [id], onDelete: SetNull)

  @@map("blocked_ips")
}
