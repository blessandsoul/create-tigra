# ===================================================================
# CLIENT APP (in Coolify: the client application only, not the server)
# ===================================================================
# Every NEXT_PUBLIC_* value is PUBLIC: Next.js bakes it into the JavaScript
# that every visitor downloads, at BUILD time. So, unlike the server's
# variables (which must never be available at build time), each of these
# needs "Available at Buildtime" ticked in Coolify (keep it available at
# runtime too). Never put a secret here. Changing one needs a redeploy, which
# rebuilds the image; a restart is not enough.

# The server's public API address, ending in /api/v1. Required: the image
# build stops when it is empty (client/Dockerfile).
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1

# App name shown in the UI. Optional (defaults to "My App").
NEXT_PUBLIC_APP_NAME={{PROJECT_DISPLAY_NAME}}
